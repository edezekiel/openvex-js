{
  "name": "openvex-js",
  "version": "0.0.0",
  "description": "TypeScript implementation of the OpenVEX specification",
  "type": "module",
  "packageManager": "pnpm@10.21.0",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "files": [
    "dist",
    "package.json",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "install-vexctl": "node scripts/install-vexctl.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsdown; test -f dist/index.mjs",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "biome": "biome check .",
    "biome:fix": "biome check --write .",
    "prepublishOnly": "pnpm run build"
  },
  "keywords": [
    "openvex",
    "vex",
    "vulnerability",
    "security",
    "sbom",
    "cve",
    "supply-chain",
    "compliance"
  ],
  "author": "Edward Ezekiel <ed.a.ezekiel@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/edezekiel/openvex-js.git"
  },
  "homepage": "https://github.com/edezekiel/openvex-js",
  "bugs": {
    "url": "https://github.com/edezekiel/openvex-js/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "peerDependencies": {
    "@js-temporal/polyfill": "^0.5.1",
    "zod": "^3.23.0 || ^4.0.0"
  },
  "peerDependenciesMeta": {
    "@js-temporal/polyfill": {
      "optional": false
    },
    "zod": {
      "optional": false
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.11",
    "@changesets/cli": "^2.29.8",
    "@js-temporal/polyfill": "^0.5.1",
    "@types/node": "^25.0.9",
    "@vitest/coverage-v8": "^4.0.17",
    "tsdown": "^0.20.0-beta.3",
    "typescript": "^5.9.3",
    "vitest": "^4.0.17",
    "zod": "^3.23.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}