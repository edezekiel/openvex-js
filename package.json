{
  "name": "openvex-js",
  "version": "0.0.0",
  "description": "TypeScript implementation of the OpenVEX specification",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "package.json",
    "README.md"
  ],
  "scripts": {
    "install-vexctl": "node scripts/install-vexctl.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsdown; test -f dist/index.mjs && test -f dist/index.cjs",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "biome": "biome check .",
    "biome:fix": "biome check --write ."
  },
  "keywords": [
    "openvex",
    "vex",
    "vulnerability",
    "security",
    "sbom"
  ],
  "author": "Edward Ezekiel <ed.a.ezekiel@gmail.com>",
  "license": "MIT",
  "engines": {
    "node": ">=23.6.0"
  },
  "peerDependencies": {
    "@js-temporal/polyfill": "^0.5.1",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.11",
    "@js-temporal/polyfill": "^0.5.1",
    "@types/node": "^25.0.9",
    "@vitest/coverage-v8": "^4.0.17",
    "tsdown": "^0.20.0-beta.3",
    "typescript": "^5.9.3",
    "vitest": "^4.0.17",
    "zod": "^3.23.0"
  }
}
